# BeyondStyle Configuration
# Copy this file to .env and fill in your values.

# ============================================
# Backend selection (teacher model for paired dataset)
# ============================================
# One of: siliconflow | openai | local
BEYONDSTYLE_BACKEND=siliconflow

# ============================================
# Teacher model — produces AI continuations in build_dataset.py
# ============================================
BEYONDSTYLE_MODEL_NAME=Qwen/Qwen3.5-397B-A17B

# ============================================
# Student model — local HF model used for extraction + steering
# ============================================
# Directory or HF repo. Its basename becomes <model_id> in output paths.
BEYONDSTYLE_MODEL_PATH=../../models/Llama-3.1-8B-Instruct

# ============================================
# Paired-dataset path (optional)
# ============================================
# If unset, scripts auto-detect the latest paired_*.json under
# data/paired/<lang>/ (or legacy outputs/dataset/).
# BEYONDSTYLE_DATASET=data/paired/en/paired_Qwen3.5-397B-A17B.json

# ============================================
# Held-out test prompts for steered generation
# ============================================
# BEYONDSTYLE_TEST_PROMPTS=data/prompts/en/default.json

# ============================================
# Output base directory
# ============================================
# BEYONDSTYLE_OUTPUT_DIR=outputs

# ============================================
# SiliconFlow API (teacher backend = siliconflow)
# ============================================
SILICONFLOW_API_KEY=your_api_key_here

# ============================================
# OpenAI API (teacher backend = openai)
# ============================================
# OPENAI_API_KEY=your_api_key_here
# BEYONDSTYLE_MODEL_NAME=gpt-4o-mini

# ============================================
# Winston AI-detection API (scripts/eval_winston.py)
# ============================================
# Get a key at https://gowinston.ai
WINSTON_API_KEY=your_winston_key_here
