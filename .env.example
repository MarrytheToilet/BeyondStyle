# Project Configuration  (copy to .env and fill in)
#
# Output paths are organised as:
#   {OUTPUT_DIR}/{lang}/{section}/{model_id}/{dataset_tag}/...
# The `dataset_tag` is the basename of the paired file (e.g. mixed_500,
# owt_300, ...). Different datasets must use different tags so their
# results never overwrite each other. Pass the paired file explicitly
# on the CLI rather than baking one into PAIRED_DATASET.

# ============================================
# Generation backend  (teacher model for paired dataset)
# ============================================
# One of: siliconflow | openai | local
GEN_BACKEND=siliconflow

# ============================================
# API model — produces AI continuations in build_dataset.py
# ============================================
# Current pool (OpenWebText cross-domain experiment):
#   deepseek-ai/DeepSeek-V4-Flash
#   Pro/MiniMaxAI/MiniMax-M2.5
#   Qwen/Qwen3.6-27B
API_MODEL=deepseek-ai/DeepSeek-V4-Flash

# ============================================
# Local model — for hidden-state extraction and steering
# ============================================
# HF directory or repo id. Its basename becomes <model_id> in output paths.
LOCAL_MODEL_PATH=/root/autodl-tmp/models/Llama-3.1-8B-Instruct

# ============================================
# Paired-dataset path  (optional)
# ============================================
# Leave UNSET. Pass --paired explicitly per run to avoid mixing datasets
# (e.g. mixed_500 vs owt_300). If set, scripts will use this default.
# PAIRED_DATASET=data/paired/en/paired_mixed_500.json

# ============================================
# Held-out test prompts for steered generation
# ============================================
# TEST_PROMPTS=data/prompts/en/default.json

# ============================================
# Output base directory
# ============================================
# OUTPUT_DIR=outputs

# ============================================
# SiliconFlow API  (GEN_BACKEND=siliconflow)
# ============================================
SILICONFLOW_API_KEY=your_siliconflow_key_here
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ============================================
# OpenAI API  (GEN_BACKEND=openai)
# ============================================
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# Pangram AI-detection API  (scripts/eval_pangram.py)
# ============================================
PANGRAM_API_KEY=your_pangram_key_here

# ============================================
# Winston AI-detection API  (legacy; scripts/eval_winston.py)
# ============================================
# WINSTON_API_KEY=your_winston_key_here
