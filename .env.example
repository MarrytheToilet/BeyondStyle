# Project Configuration  (copy to .env and fill in)
#
# Output paths are organised as:
#   {OUTPUT_DIR}/{lang}/{section}/{model_id}/{dataset_tag}/...
# Direction fitting uses `proposition_aligned`; interface transfer uses
# `prefix_only_control` without refitting those directions.

# ============================================
# Generation backend  (teacher model for paired dataset)
# ============================================
# One of: api | local
GEN_BACKEND=api

# ============================================
# OpenAI-compatible generation API
# ============================================
# API_MODEL is the single-model fallback. If API_MODELS is set,
# synthesize_paired_data.py distributes work across that comma-separated pool.
API_KEY=your_generation_api_key_here
API_BASE_URL=https://api.example.com/v1
API_MODEL=teacher-model-a
# API_MODELS=teacher-model-a,teacher-model-b,teacher-model-c

# ============================================
# Local model — for hidden-state extraction and steering
# ============================================
# HF directory or repo id. Its basename becomes <model_id> in output paths.
# Formal shell runners pass each model explicitly; this remains the fallback
# used by single-model entry points when no explicit model is supplied.
LOCAL_MODEL_PATH=/path/to/models/Qwen3-4B

# ============================================
# Paired-dataset path  (optional)
# ============================================
# Leave UNSET. Pass the language-specific path explicitly per run.
# PAIRED_DATASET=data/paired/en/proposition_aligned/pairs.jsonl

# ============================================
# Held-out test prompts for steered generation
# ============================================
# Pass --prompts explicitly to run_steering_generation.py. Formal prompt files
# must be independent of the paired training rows and recorded by hash.
# TEST_PROMPTS=data/prompts/en/formal.json

# ============================================
# Output base directory
# ============================================
# OUTPUT_DIR=outputs

# ============================================
# Pangram AI-detection API  (scripts/eval_pangram.py)
# ============================================
PANGRAM_API_KEY=your_pangram_key_here
