# BeyondStyle Configuration
# Copy this file to .env and fill in your values

# ============================================
# Backend Selection (for dataset construction)
# ============================================
# Options: "siliconflow", "openai", "local"
# Use API backend for dataset construction (better quality).
BEYONDSTYLE_BACKEND=siliconflow

# ============================================
# API Model — for dataset construction (build_dataset.py)
# ============================================
# This is the remote model used to generate AI continuations.
BEYONDSTYLE_MODEL_NAME=Qwen/Qwen3.5-397B-A17B

# ============================================
# Local Model — for extraction & steering (steering_pipeline.py)
# ============================================
# Path to local HuggingFace model for hidden-state extraction and steering.
# The directory name becomes the model_id for organizing outputs.
BEYONDSTYLE_MODEL_PATH=../../models/Llama-3.1-8B-Instruct

# ============================================
# Dataset Path
# ============================================
# Path to paired dataset for steering/analysis.
# If not set, scripts will auto-detect the latest in outputs/dataset/.
# BEYONDSTYLE_DATASET=outputs/dataset/paired_dataset_Qwen3.5-397B-A17B.json

# ============================================
# Test Prompts
# ============================================
# Path to test prompts JSON file (list of strings).
# Default: data/prompts/default.json
# BEYONDSTYLE_TEST_PROMPTS=data/prompts/default.json

# ============================================
# SiliconFlow API Configuration
# ============================================
SILICONFLOW_API_KEY=your_api_key_here

# ============================================
# OpenAI API Configuration (optional)
# ============================================
# BEYONDSTYLE_BACKEND=openai
# OPENAI_API_KEY=your_api_key_here
# BEYONDSTYLE_MODEL_NAME=gpt-4o-mini
